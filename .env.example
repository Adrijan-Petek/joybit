# Joybit Match-3 environment
# Copy to .env.local and fill values.

# Frontend contract addresses
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_MATCH3_GAME_ADDRESS=

# Wallet/RPC
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Optional OnchainKit key
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Hidden admin unlock (wallet or FID)
NEXT_PUBLIC_ADMIN_WALLET_ADDRESS=
NEXT_PUBLIC_ADMIN_WALLET_ADDRESSES=
NEXT_PUBLIC_ADMIN_FARCASTER_FID=

# Turso (leaderboard + match3 stats API)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Hardhat deployment/verification
PRIVATE_KEY=
BASESCAN_API_KEY=
